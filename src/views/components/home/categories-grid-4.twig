{# =============================================================================
   سكشن: أربع أقسام مع صور مربعة (4 Categories Grid)
   الوصف: عرض 4 أقسام رئيسية للمتجر في شبكة جذابة مع صور مربعة وتأثيرات
   Created for: متجر mypetttt على منصة سله
   ============================================================================= #}

<section class="categories-grid-4-section py-16 md:py-20" dir="{{ direction }}">
    <div class="container mx-auto px-4">
        {# عنوان القسم #}
        <div class="section-title text-center mb-12">
            <span class="inline-block text-blue-600 font-semibold text-sm uppercase tracking-wider mb-2">
                {{ section.settings.badge_text | default('أقسام المتجر') }}
            </span>
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
                {{ section.settings.title | default('تسوق حسب القسم') }}
            </h2>
            {% if section.settings.subtitle %}
                <p class="text-gray-600 max-w-2xl mx-auto text-lg">{{ section.settings.subtitle }}</p>
            {% endif %}
        </div>
        
        {# شبكة الأقسام - تصميم 2x2 #}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            
            {# عرض الأقسام الأربعة #}
            {% for category in section.settings.categories %}
                <div class="category-card group relative overflow-hidden rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 {% if loop.first %}md:col-span-1{% endif %}">
                    
                    {# صورة القسم #}
                    <div class="aspect-square overflow-hidden">
                        <img src="{{ category.image | default('https://via.placeholder.com/600x600?text=Category') }}" 
                             alt="{{ category.name }}"
                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                    </div>
                    
                    {# طبقة التدرج اللوني #}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
                    
                    {# محتوى القسم #}
                    <div class="absolute bottom-0 left-0 right-0 p-6 text-white transform transition-transform duration-500 group-hover:translate-y-[-4px]">
                        <h3 class="text-2xl md:text-3xl font-bold mb-2">{{ category.name }}</h3>
                        
                        {% if category.description %}
                            <p class="text-sm text-gray-200 mb-3 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                                {{ category.description }}
                            </p>
                        {% endif %}
                        
                        {# زر الانتقال للقسم #}
                        <a href="{{ category.link | default('#') }}" 
                           class="inline-flex items-center text-white font-medium group-hover:text-blue-300 transition">
                            <span>تسوق الآن</span>
                            <svg class="w-4 h-4 mr-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                    </div>
                    
                    {# عداد المنتجات (اختياري) #}
                    {% if category.products_count %}
                        <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm rounded-full px-3 py-1 text-sm font-medium text-gray-800">
                            {{ category.products_count }} منتج
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        
        {# صف إضافي لعلامات تجارية أو عروض (اختياري) #}
        {% if section.settings.show_promo %}
            <div class="mt-8 bg-gradient-to-r from-blue-600 to-blue-800 rounded-2xl p-6 text-white text-center">
                <p class="text-lg mb-2">{{ section.settings.promo_text | default('عروض حصرية على جميع الأقسام') }}</p>
                <a href="{{ section.settings.promo_link | default('#') }}" class="inline-block bg-white text-blue-600 font-bold px-6 py-2 rounded-lg hover:bg-blue-50 transition">
                    استكشف العروض
                </a>
            </div>
        {% endif %}
    </div>
</section>

