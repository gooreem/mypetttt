{# =============================================================================
   سكشن: تقييمات العملاء المتقدمة (Advanced Testimonials)
   الوصف: عرض آراء العملاء بتصميم كروت متحركة مع صور وتقييمات نجوم
   Created for: متجر mypetttt على منصة سله
   ============================================================================= #}

<section class="advanced-testimonials-section py-16 md:py-20 bg-gradient-to-b from-gray-50 to-white" dir="{{ direction }}">
    <div class="container mx-auto px-4">
        {# عنوان القسم #}
        <div class="section-title text-center mb-12">
            <span class="inline-block text-blue-600 font-semibold text-sm uppercase tracking-wider mb-2">
                {{ section.settings.badge_text | default('آراء العملاء') }}
            </span>
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
                {{ section.settings.title | default('ماذا يقول عملاؤنا عنا') }}
            </h2>
            {% if section.settings.subtitle %}
                <p class="text-gray-600 max-w-2xl mx-auto text-lg">{{ section.settings.subtitle }}</p>
            {% endif %}
        </div>
        
        {# التقييمات الإحصائية (اختياري) #}
        {% if section.settings.show_stats %}
        <div class="stats-container grid grid-cols-2 md:grid-cols-4 gap-4 mb-12 max-w-3xl mx-auto">
            <div class="stat-item text-center p-4">
                <div class="text-3xl md:text-4xl font-bold text-blue-600">+500</div>
                <div class="text-sm text-gray-600 mt-1">عميل سعيد</div>
            </div>
            <div class="stat-item text-center p-4">
                <div class="text-3xl md:text-4xl font-bold text-blue-600">4.8</div>
                <div class="text-sm text-gray-600 mt-1">تقييم عام</div>
            </div>
            <div class="stat-item text-center p-4">
                <div class="text-3xl md:text-4xl font-bold text-blue-600">+50</div>
                <div class="text-sm text-gray-600 mt-1">تقييم جديد</div>
            </div>
            <div class="stat-item text-center p-4">
                <div class="text-3xl md:text-4xl font-bold text-blue-600">98%</div>
                <div class="text-sm text-gray-600 mt-1">توصية</div>
            </div>
        </div>
        {% endif %}
        
        {# شبكة التقييمات - تظهر بشكل مختلف حسب الاختيار #}
        {% if section.settings.display_style == 'grid' %}
            {# عرض شبكي #}
            <div class="testimonials-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for testimonial in section.settings.testimonials %}
                    <div class="testimonial-card bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 p-6 border border-gray-100">
                        <div class="flex items-center mb-4">
                            {# صورة العميل #}
                            <div class="w-16 h-16 rounded-full overflow-hidden ml-4 border-2 border-blue-100">
                                {% if testimonial.avatar %}
                                    <img src="{{ testimonial.avatar }}" alt="{{ testimonial.name }}" class="w-full h-full object-cover">
                                {% else %}
                                    <div class="w-full h-full bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center text-white text-xl font-bold">
                                        {{ testimonial.name | slice(0, 1) }}
                                    </div>
                                {% endif %}
                            </div>
                            
                            <div class="flex-1">
                                <h3 class="font-bold text-gray-900 text-lg">{{ testimonial.name }}</h3>
                                {% if testimonial.position %}
                                    <p class="text-sm text-gray-500">{{ testimonial.position }}</p>
                                {% endif %}
                            </div>
                        </div>
                        
                        {# تقييم النجوم #}
                        <div class="flex items-center mb-3">
                            {% set rating = testimonial.rating | default(5) %}
                            {% for i in 1..5 %}
                                <svg class="w-5 h-5 {{ i <= rating ? 'text-yellow-400' : 'text-gray-300' }}" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                </svg>
                            {% endfor %}
                        </div>
                        
                        {# نص التقييم #}
                        <blockquote class="text-gray-700 leading-relaxed mb-4">
                            "{{ testimonial.text }}"
                        </blockquote>
                        
                        {# تاريخ التقييم (اختياري) #}
                        {% if testimonial.date %}
                            <p class="text-xs text-gray-400 mt-2">{{ testimonial.date | date('d M Y') }}</p>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
            
        {% elseif section.settings.display_style == 'slider' %}
            {# عرض سليدر #}
            <div class="testimonials-slider relative">
                <div class="swiper" id="testimonialsSlider-{{ section.id }}">
                    <div class="swiper-wrapper">
                        {% for testimonial in section.settings.testimonials %}
                            <div class="swiper-slide">
                                <div class="testimonial-card bg-white rounded-2xl shadow-lg p-8 mx-2 my-4">
                                    <div class="flex flex-col items-center text-center">
                                        {# صورة العميل #}
                                        <div class="w-20 h-20 rounded-full overflow-hidden mb-4 border-4 border-blue-100">
                                            {% if testimonial.avatar %}
                                                <img src="{{ testimonial.avatar }}" alt="{{ testimonial.name }}" class="w-full h-full object-cover">
                                            {% else %}
                                                <div class="w-full h-full bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center text-white text-2xl font-bold">
                                                    {{ testimonial.name | slice(0, 1) }}
                                                </div>
                                            {% endif %}
                                        </div>
                                        
                                        <h3 class="font-bold text-gray-900 text-xl mb-1">{{ testimonial.name }}</h3>
                                        
                                        {% if testimonial.position %}
                                            <p class="text-sm text-gray-500 mb-3">{{ testimonial.position }}</p>
                                        {% endif %}
                                        
                                        {# تقييم النجوم #}
                                        <div class="flex items-center mb-4">
                                            {% set rating = testimonial.rating | default(5) %}
                                            {% for i in 1..5 %}
                                                <svg class="w-5 h-5 {{ i <= rating ? 'text-yellow-400' : 'text-gray-300' }}" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                                </svg>
                                            {% endfor %}
                                        </div>
                                        
                                        {# أيقونة اقتباس #}
                                        <svg class="w-8 h-8 text-blue-200 mb-2" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                                        </svg>
                                        
                                        <blockquote class="text-gray-700 leading-relaxed text-lg">
                                            {{ testimonial.text }}
                                        </blockquote>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    
                    {# أزرار التنقل #}
                    <div class="swiper-button-next !text-blue-600 !bg-white !w-12 !h-12 rounded-full shadow-lg hover:!bg-blue-50 transition after:!text-lg"></div>
                    <div class="swiper-button-prev !text-blue-600 !bg-white !w-12 !h-12 rounded-full shadow-lg hover:!bg-blue-50 transition after:!text-lg"></div>
                    
                    {# نقاط التصفح #}
                    <div class="swiper-pagination !relative !bottom-0 mt-8"></div>
                </div>
            </div>
            
        {% elseif section.settings.display_style == 'masonry' %}
            {# عرض متداخل (Masonry) #}
            <div class="testimonials-masonry columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6">
                {% for testimonial in section.settings.testimonials %}
                    <div class="testimonial-card bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 p-6 border border-gray-100 break-inside-avoid mb-6">
                        <div class="flex items-center mb-4">
                            <div class="w-14 h-14 rounded-full overflow-hidden ml-3 border-2 border-blue-100">
                                {% if testimonial.avatar %}
                                    <img src="{{ testimonial.avatar }}" alt="{{ testimonial.name }}" class="w-full h-full object-cover">
                                {% else %}
                                    <div class="w-full h-full bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center text-white text-lg font-bold">
                                        {{ testimonial.name | slice(0, 1) }}
                                    </div>
                                {% endif %}
                            </div>
                            
                            <div class="flex-1">
                                <h3 class="font-bold text-gray-900">{{ testimonial.name }}</h3>
                                <div class="flex items-center mt-1">
                                    {% set rating = testimonial.rating | default(5) %}
                                    {% for i in 1..5 %}
                                        <svg class="w-4 h-4 {{ i <= rating ? 'text-yellow-400' : 'text-gray-300' }}" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                        </svg>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                        
                        <blockquote class="text-gray-700 leading-relaxed">
                            "{{ testimonial.text }}"
                        </blockquote>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
        
        {# زر إضافة تقييم #}
        {% if section.settings.show_add_button %}
            <div class="text-center mt-12">
                <button class="inline-flex items-center bg-white border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white font-bold py-3 px-8 rounded-full transition-all transform hover:scale-105">
                    <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                    <span>أضف تقييمك</span>
                </button>
            </div>
        {% endif %}
    </div>
</section>

