{# =============================================================================
   سكشن: 6 منتجات حديثة (New Products Grid 6)
   الوصف: عرض أحدث 6 منتجات مضافة للمتجر في شبكة جذابة مع تأثيرات متطورة
   Created for: متجر mypetttt على منصة سله
   ============================================================================= #}

<section class="new-products-grid-6-section py-16 md:py-20 bg-gradient-to-b from-white to-gray-50" dir="{{ direction }}">
    <div class="container mx-auto px-4">
        {# عنوان القسم مع تأثير زمني #}
        <div class="section-title text-center mb-12">
            <span class="inline-block text-blue-600 font-semibold text-sm uppercase tracking-wider mb-2 relative">
                {{ section.settings.badge_text | default('وصل حديثاً') }}
                <span class="absolute -top-1 -right-2 w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
            </span>
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
                {{ section.settings.title | default('أحدث المنتجات') }}
            </h2>
            {% if section.settings.subtitle %}
                <p class="text-gray-600 max-w-2xl mx-auto text-lg">{{ section.settings.subtitle }}</p>
            {% endif %}
        </div>
        
        {# شبكة 6 منتجات - تصميم 2x3 #}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
            
            {# هنا في المشروع الحقيقي ستجلب المنتجات من قاعدة البيانات #}
            {# للعرض التجريبي، نستخدم منتجات تجريبية #}
            {% set new_products = [
                {
                    id: 1,
                    name: "سرير فاخر للقطط",
                    price: 159,
                    old_price: 199,
                    image: "https://cdn.salla.sa/ZrBEO/MopzhoqpTkDObcKc8Q8n77AuydanfsGXdZO7iinH.jpg",
                    rating: 5,
                    reviews: 12,
                    is_new: true,
                    badge: "جديد",
                    colors: ["أحمر", "أزرق", "رمادي"]
                },
                {
                    id: 2,
                    name: "طوق ذكي للكلاب مع GPS",
                    price: 299,
                    old_price: 399,
                    image: "https://cdn.salla.sa/ZrBEO/3gOhYSaIhaHxhH2IHWxJYDl9JHwxP6dGKiZFSq4K.jpg",
                    rating: 4,
                    reviews: 8,
                    is_new: true,
                    badge: "حصري",
                    colors: ["أسود", "بني"]
                },
                {
                    id: 3,
                    name: "لعبة تفاعلية مع صوت",
                    price: 89,
                    old_price: null,
                    image: "https://cdn.salla.sa/ZrBEO/8kH2jHsL9pQrTsV5wNxYzA1bC3dE4fG5hI6jK7lM.jpg",
                    rating: 4.5,
                    reviews: 23,
                    is_new: true,
                    badge: "جديد",
                    colors: []
                },
                {
                    id: 4,
                    name: "حقيبة حمل عصرية",
                    price: 189,
                    old_price: 229,
                    image: "https://cdn.salla.sa/ZrBEO/9mNxLkHjGfDcVbNmQwErTyUiOpAsDfGhJkLzXcVb.jpg",
                    rating: 4,
                    reviews: 15,
                    is_new: true,
                    badge: "تخفيض",
                    colors: ["زهري", "أزرق", "أسود"]
                },
                {
                    id: 5,
                    name: "طبق طعام ذكي",
                    price: 129,
                    old_price: 159,
                    image: "https://cdn.salla.sa/ZrBEO/2aSdFgHjKlQwErTyUiOpZxCvBnMqWeRtYuIoPa.jpg",
                    rating: 5,
                    reviews: 31,
                    is_new: false,
                    badge: "",
                    colors: ["أبيض", "رمادي"]
                },
                {
                    id: 6,
                    name: "مجموعة عناية فاخرة",
                    price: 249,
                    old_price: 299,
                    image: "https://cdn.salla.sa/ZrBEO/5lKjHgFdSaPpOoIiUuYtRrEeWwQqZzXcVvBbNn.jpg",
                    rating: 4.5,
                    reviews: 19,
                    is_new: true,
                    badge: "طقم هدايا",
                    colors: []
                }
            ] %}
            
            {% for product in new_products %}
                <div class="product-card group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 overflow-hidden relative">
                    
                    {# شارة "جديد" متحركة #}
                    {% if product.is_new and section.settings.show_new_badge %}
                        <div class="absolute top-4 right-4 z-20">
                            <span class="relative inline-flex">
                                <span class="animate-ping absolute inset-0 rounded-full bg-green-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full bg-green-500 px-3 py-1 text-xs font-bold text-white">
                                    جديد
                                </span>
                            </span>
                        </div>
                    {% endif %}
                    
                    {# شارة إضافية #}
                    {% if product.badge and product.badge != '' %}
                        <div class="absolute top-4 left-4 z-20">
                            <span class="bg-blue-600 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-lg">
                                {{ product.badge }}
                            </span>
                        </div>
                    {% endif %}
                    
                    {# صورة المنتج #}
                    <div class="product-image relative pt-[100%] bg-gray-100 overflow-hidden">
                        <img src="{{ product.image }}" 
                             alt="{{ product.name }}"
                             class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                        
                        {# طبقة التأثير #}
                        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        
                        {# أزرار الإجراءات السريعة #}
                        <div class="absolute inset-x-0 bottom-0 p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-500">
                            <div class="flex gap-2">
                                <button class="flex-1 bg-white text-gray-800 hover:bg-blue-600 hover:text-white font-medium py-2.5 rounded-lg text-sm transition-all transform hover:scale-105 shadow-lg">
                                    <span class="flex items-center justify-center">
                                        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                                        </svg>
                                        أضف للسلة
                                    </span>
                                </button>
                                <button class="w-10 h-10 bg-white rounded-lg flex items-center justify-center text-gray-600 hover:bg-blue-600 hover:text-white transition-all transform hover:scale-110 shadow-lg">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    {# معلومات المنتج #}
                    <div class="product-info p-4">
                        <h3 class="font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-blue-600 transition-colors">
                            <a href="#">{{ product.name }}</a>
                        </h3>
                        
                        {# التقييم #}
                        {% if section.settings.show_rating %}
                            <div class="flex items-center mb-3">
                                <div class="flex text-yellow-400">
                                    {% set rating = product.rating %}
                                    {% for i in 1..5 %}
                                        {% if i <= rating %}
                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                            </svg>
                                        {% else %}
                                            <svg class="w-4 h-4 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                            </svg>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                <span class="text-xs text-gray-500 mr-2">({{ product.reviews }})</span>
                            </div>
                        {% endif %}
                        
                        {# الألوان المتاحة #}
                        {% if product.colors and product.colors|length > 0 %}
                            <div class="flex items-center mb-3">
                                <span class="text-xs text-gray-500 ml-2">الألوان:</span>
                                <div class="flex gap-1">
                                    {% for color in product.colors %}
                                        <span class="w-4 h-4 rounded-full bg-{{ color }} border border-gray-300" title="{{ color }}"></span>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                        
                        {# السعر #}
                        <div class="flex items-baseline justify-between">
                            <div>
                                <span class="text-2xl font-bold text-blue-600">{{ product.price }} ريال</span>
                                {% if product.old_price %}
                                    <span class="text-sm text-gray-400 line-through mr-2">{{ product.old_price }} ريال</span>
                                {% endif %}
                            </div>
                            
                            {# نسبة التخفيض #}
                            {% if product.old_price %}
                                {% set discount = ((product.old_price - product.price) / product.old_price * 100)|round %}
                                <span class="bg-red-100 text-red-600 text-xs font-bold px-2 py-1 rounded">
                                    -{{ discount }}%
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        
        {# زر عرض المزيد #}
        {% if section.settings.show_view_all %}
            <div class="text-center mt-12">
                <a href="{{ section.settings.view_all_link | default('/new-arrivals') }}" 
                   class="inline-flex items-center bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-bold py-3 px-8 rounded-lg transition-all transform hover:scale-105 shadow-lg hover:shadow-xl">
                    <span>عرض جميع المنتجات الجديدة</span>
                    <svg class="w-5 h-5 mr-2 animate-bounce-x" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </a>
            </div>
        {% endif %}
    </div>
</section>

{% schema %}
{
    "name": {
        "ar": "6 منتجات حديثة",
        "en": "6 New Products"
    },
    "icon": "sicon-layout-grid",
    "description": {
        "ar": "عرض أحدث 6 منتجات مضافة للمتجر في شبكة جذابة",
        "en": "Display the latest 6 products in an attractive grid"
    },
    "settings": [
        {
            "type": "string",
            "id": "badge_text",
            "label": {
                "ar": "نص الشارة",
                "en": "Badge Text"
            },
            "format": "text",
            "multilanguage": true,
            "value": {
                "ar": "وصل حديثاً",
                "en": "New Arrivals"
            }
        },
        {
            "type": "string",
            "id": "title",
            "label": {
                "ar": "عنوان القسم",
                "en": "Section Title"
            },
            "format": "text",
            "multilanguage": true,
            "value": {
                "ar": "أحدث المنتجات",
                "en": "New Products"
            }
        },
        {
            "type": "string",
            "id": "subtitle",
            "label": {
                "ar": "نص فرعي",
                "en": "Subtitle"
            },
            "format": "textarea",
            "multilanguage": true,
            "required": false,
            "placeholder": {
                "ar": "أضف نصاً وصفياً للقسم...",
                "en": "Add a descriptive text..."
            }
        },
        {
            "type": "items",
            "id": "selected_products",
            "label": {
                "ar": "منتجات محددة (اختياري)",
                "en": "Specific Products (Optional)"
            },
            "format": "dropdown-list",
            "selected": [],
            "options": [],
            "required": false,
            "multichoice": true,
            "source": "products",
            "searchable": true,
            "maxLength": 6,
            "description": {
                "ar": "اختر منتجات معينة أو اتركها فارغة لأحدث المنتجات",
                "en": "Select specific products or leave empty for latest products"
            }
        },
        {
            "type": "boolean",
            "id": "show_new_badge",
            "label": {
                "ar": "إظهار شارة 'جديد'",
                "en": "Show 'New' Badge"
            },
            "format": "switch",
            "value": true
        },
        {
            "type": "boolean",
            "id": "show_rating",
            "label": {
                "ar": "إظهار التقييمات",
                "en": "Show Ratings"
            },
            "format": "switch",
            "value": true
        },
        {
            "type": "boolean",
            "id": "show_old_price",
            "label": {
                "ar": "إظهار السعر القديم",
                "en": "Show Old Price"
            },
            "format": "switch",
            "value": true
        },
        {
            "type": "boolean",
            "id": "show_colors",
            "label": {
                "ar": "إظهار الألوان المتاحة",
                "en": "Show Available Colors"
            },
            "format": "switch",
            "value": true
        },
        {
            "type": "boolean",
            "id": "show_view_all",
            "label": {
                "ar": "إظهار زر عرض الكل",
                "en": "Show View All Button"
            },
            "format": "switch",
            "value": true
        },
        {
            "type": "items",
            "id": "view_all_link",
            "label": {
                "ar": "رابط عرض الكل",
                "en": "View All Link"
            },
            "format": "variable-list",
            "required": false,
            "source": "custom",
            "sources": [
                {"label": {"ar": "صفحة المنتجات", "en": "Products Page"}, "key": "products_link", "value": "products_link"},
                {"label": {"ar": "التخفيضات", "en": "Offers"}, "key": "offers_link", "value": "offers_link"},
                {"label": {"ar": "رابط خارجي", "en": "Custom URL"}, "key": "custom", "value": "custom"}
            ],
            "conditions": [
                {
                    "id": "show_view_all",
                    "operation": "=",
                    "value": true
                }
            ]
        }
    ]
}
{% endschema %}

<style>
/* أنيميشن مخصص للسهم */
@keyframes bounce-x {
    0%, 100% {
        transform: translateX(0);
    }
    50% {
        transform: translateX(5px);
    }
}

.animate-bounce-x {
    animation: bounce-x 1s infinite;
}

/* تأثيرات متقدمة للكروت */
.product-card {
    position: relative;
}

.product-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 2px;
    background: linear-gradient(145deg, transparent 0%, rgba(33, 99, 109, 0.1) 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
}

.product-card:hover::before {
    opacity: 1;
}

/* تأثير نبض لشارة جديد */
@keyframes newPulse {
    0%, 100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.1);
    }
}

.absolute.top-4.right-4 .relative.inline-flex {
    animation: newPulse 2s infinite;
}

/* تنسيق ألوان الألوان */
.bg-أحمر { background-color: #ef4444; }
.bg-أزرق { background-color: #3b82f6; }
.bg-رمادي { background-color: #6b7280; }
.bg-أسود { background-color: #1f2937; }
.bg-بني { background-color: #8b5a2b; }
.bg-زهري { background-color: #ec4899; }
.bg-أبيض { background-color: #ffffff; border: 1px solid #e5e7eb; }

/* تجاوب للشاشات الصغيرة */
@media (max-width: 640px) {
    .product-card .text-2xl {
        font-size: 1.25rem;
    }
    
    .product-card .p-4 {
        padding: 0.75rem;
    }
    
    .product-card h3 {
        font-size: 0.9rem;
    }
}

/* تأثير توهج على الصور */
@keyframes imageGlow {
    0% { box-shadow: 0 0 0 0 rgba(33, 99, 109, 0.3); }
    70% { box-shadow: 0 0 0 10px rgba(33, 99, 109, 0); }
    100% { box-shadow: 0 0 0 0 rgba(33, 99, 109, 0); }
}

.product-card:hover .product-image img {
    animation: imageGlow 2s infinite;
}
</style>