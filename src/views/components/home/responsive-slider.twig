{# =============================================================================
   سكشن: سليدر متجاوب (Responsive Slider)
   الوصف: سليدر يعرض 3 صور - في الكمبيوتر أفقي، في الجوال عمودي
   Created for: متجر mypetttt على منصة سله
   ============================================================================= #}

<section class="responsive-slider-section py-6 md:py-8" dir="{{ direction }}">
    <div class="container mx-auto px-4">
        {# عنوان السكشن إذا كان موجوداً في الإعدادات #}
        {% if section.settings.title %}
            <div class="section-title text-center mb-6 md:mb-8">
                <h2 class="text-2xl md:text-3xl font-bold text-gray-900">{{ section.settings.title }}</h2>
            </div>
        {% endif %}
        
        {# =========================================================================
           وضع الكمبيوتر: سليدر أفقي (يظهر فقط في الشاشات المتوسطة والكبيرة)
           ========================================================================= #}
        <div class="hidden md:block relative slider-desktop">
            {% if section.settings.slides | length > 0 %}
                <div class="swiper main-slider" id="desktopSlider-{{ section.id }}" dir="ltr">
                    <div class="swiper-wrapper">
                        {% for slide in section.settings.slides %}
                            <div class="swiper-slide">
                                <div class="relative rounded-xl overflow-hidden group cursor-pointer" 
                                     onclick="window.location='{{ slide.link | default('javascript:void(0)') }}'">
                                    {# صورة السليدر #}
                                    <img src="{{ slide.image }}" 
                                         alt="{{ slide.title | default('') }}" 
                                         class="w-full h-[400px] lg:h-[500px] object-cover transition-transform duration-700 group-hover:scale-105">
                                    
                                    {# طبقة تعتم خفيفة #}
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                                    
                                    {# محتوى نصي على الصورة #}
                                    {% if slide.title or slide.description %}
                                        <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8 text-white text-right">
                                            {% if slide.title %}
                                                <h3 class="text-2xl md:text-4xl font-bold mb-2 drop-shadow-lg">{{ slide.title }}</h3>
                                            {% endif %}
                                            {% if slide.description %}
                                                <p class="text-base md:text-lg opacity-90 drop-shadow">{{ slide.description }}</p>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    
                    {# أزرار التنقل (أسهم) #}
                    <div class="swiper-button-next !text-white !bg-black/30 !w-10 !h-10 rounded-full hover:!bg-black/50 transition"></div>
                    <div class="swiper-button-prev !text-white !bg-black/30 !w-10 !h-10 rounded-full hover:!bg-black/50 transition"></div>
                    
                    {# نقاط التصفح #}
                    <div class="swiper-pagination !relative !bottom-0 mt-4"></div>
                </div>
            {% else %}
                {# رسالة إذا لم توجد صور - تظهر فقط للمطور #}
                {% if is_developer_mode %}
                    <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 p-4 rounded-lg text-center">
                        يرجى إضافة صور للسليدر من إعدادات القسم
                    </div>
                {% endif %}
            {% endif %}
        </div>
        
        {# =========================================================================
           وضع الجوال: شبكة عمودية (يظهر فقط في الشاشات الصغيرة)
           ========================================================================= #}
        <div class="block md:hidden mobile-grid space-y-4">
            {% if section.settings.slides | length > 0 %}
                {% for slide in section.settings.slides %}
                    <div class="mobile-slide-item relative rounded-xl overflow-hidden group cursor-pointer"
                         onclick="window.location='{{ slide.link | default('javascript:void(0)') }}'">
                        {# صورة السليدر #}
                        <img src="{{ slide.image }}" 
                             alt="{{ slide.title | default('') }}" 
                             class="w-full h-[250px] object-cover transition-transform duration-500 group-hover:scale-105">
                        
                        {# طبقة تعتم خفيفة #}
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                        
                        {# محتوى نصي على الصورة #}
                        {% if slide.title or slide.description %}
                            <div class="absolute bottom-0 left-0 right-0 p-4 text-white text-right">
                                {% if slide.title %}
                                    <h3 class="text-xl font-bold mb-1 drop-shadow-lg">{{ slide.title }}</h3>
                                {% endif %}
                                {% if slide.description %}
                                    <p class="text-sm opacity-90 drop-shadow">{{ slide.description }}</p>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</section>

