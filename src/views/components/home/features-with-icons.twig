{# =============================================================================
   سكشن: مميزات المتجر مع صور (Features with Icons)
   الوصف: عرض مميزات المتجر في كروت جذابة مع أيقونات وصور توضيحية
   Created for: متجر mypetttt على منصة سله
   ============================================================================= #}

<section class="features-with-icons-section py-16 md:py-20 bg-gradient-to-b from-white to-gray-50" dir="{{ direction }}">
    <div class="container mx-auto px-4">
        {# عنوان القسم #}
        <div class="section-title text-center mb-12">
            <span class="inline-block text-blue-600 font-semibold text-sm uppercase tracking-wider mb-2">
                {{ section.settings.badge_text | default('مميزاتنا') }}
            </span>
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
                {{ section.settings.title | default('لماذا تختار متجرنا؟') }}
            </h2>
            {% if section.settings.subtitle %}
                <p class="text-gray-600 max-w-2xl mx-auto text-lg">{{ section.settings.subtitle }}</p>
            {% endif %}
        </div>
        
        {# شبكة المميزات #}
        <div class="features-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
            
            {% for feature in section.settings.features %}
                <div class="feature-card group relative bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden {% if feature.highlight %}ring-2 ring-blue-500 ring-offset-2{% endif %}">
                    
                    {# خلفية متحركة عند التمرير #}
                    <div class="absolute inset-0 bg-gradient-to-br from-blue-50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    
                    <div class="relative p-6 text-center">
                        {# صورة الميزة (إذا وجدت) #}
                        {% if feature.image %}
                            <div class="feature-image mb-4 relative">
                                <div class="w-24 h-24 mx-auto rounded-2xl bg-gradient-to-br from-blue-100 to-blue-50 p-1 group-hover:scale-110 transition-transform duration-300">
                                    <img src="{{ feature.image }}" 
                                         alt="{{ feature.title }}"
                                         class="w-full h-full object-contain rounded-xl">
                                </div>
                                {# تأثير وميض #}
                                <div class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 rounded-full blur-xl transition-opacity"></div>
                            </div>
                        {% else %}
                            {# أيقونة الميزة (إذا لم توجد صورة) #}
                            <div class="feature-icon mb-4">
                                <div class="w-20 h-20 mx-auto rounded-2xl bg-gradient-to-br from-blue-600 to-blue-700 text-white flex items-center justify-center text-3xl group-hover:scale-110 transition-transform duration-300 shadow-lg">
                                    <span class="{{ feature.icon | default('sicon-star') }}"></span>
                                </div>
                            </div>
                        {% endif %}
                        
                        {# محتوى الميزة #}
                        <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
                            {{ feature.title }}
                        </h3>
                        
                        <p class="text-gray-600 leading-relaxed mb-4">
                            {{ feature.description }}
                        </p>
                        
                        {# تفاصيل إضافية (اختياري) #}
                        {% if feature.detail %}
                            <div class="text-sm text-blue-600 font-medium mt-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                {{ feature.detail }}
                            </div>
                        {% endif %}
                        
                        {# خط سفلي متحرك #}
                        <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-blue-400 to-blue-600 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>
                    </div>
                </div>
            {% endfor %}
        </div>
        
        {# صف إضافي من المميزات (إذا كان العدد أكبر من 4) #}
        {% if section.settings.features | length > 4 %}
            <div class="features-grid-secondary grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
                {% for feature in section.settings.features | slice(4, 4) %}
                    <div class="feature-mini-card bg-white rounded-xl shadow-sm hover:shadow-md transition p-4 flex items-center space-x-3 space-x-reverse">
                        <div class="feature-mini-icon w-10 h-10 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center flex-shrink-0">
                            <span class="{{ feature.icon | default('sicon-check') }}"></span>
                        </div>
                        <div class="flex-1 text-right">
                            <h4 class="font-medium text-gray-900 text-sm">{{ feature.title }}</h4>
                            {% if feature.description %}
                                <p class="text-xs text-gray-500 mt-1">{{ feature.description | slice(0, 50) }}...</p>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
        
        {# زر معرفة المزيد #}
        {% if section.settings.show_more_button %}
            <div class="text-center mt-12">
                <a href="{{ section.settings.more_button_link | default('#') }}" 
                   class="inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg transition-all transform hover:scale-105 shadow-lg hover:shadow-xl">
                    <span>{{ section.settings.more_button_text | default('اكتشف المزيد من المميزات') }}</span>
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </a>
            </div>
        {% endif %}
    </div>
</section>

