<style>
/* تنسيقات متقدمة */
.feature-card {
    position: relative;
    z-index: 1;
}

.feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(33, 99, 109, 0.05) 0%, rgba(33, 99, 109, 0) 100%);
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.5s;
    z-index: -1;
}

.feature-card:hover::before {
    opacity: 1;
}

/* تأثيرات للكروت الصغيرة */
.feature-mini-card {
    transition: all 0.3s ease;
}

.feature-mini-card:hover {
    transform: translateY(-2px);
    background: linear-gradient(to left, #fff, #f8f9fa);
}

/* تنسيقات تجاوبية */
@media (max-width: 768px) {
    .features-grid {
        gap: 1rem;
    }
    
    .feature-card .w-24 {
        width: 5rem;
        height: 5rem;
    }
    
    .features-grid-secondary {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* أنيميشن للأيقونات */
@keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-5px); }
    100% { transform: translateY(0px); }
}

.feature-card:hover .feature-icon div,
.feature-card:hover .feature-image div {
    animation: float 2s ease-in-out infinite;
}

/* تأثير للكروت المميزة */
.feature-card[class*="ring-2"] {
    background: linear-gradient(135deg, #fff, #f0f9ff);
}
</style>