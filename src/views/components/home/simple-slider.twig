{# Simple Slider Section #}
<section class="py-12">
    <div class="container mx-auto px-4">
        {% if section.settings.main_title %}
            <h2 class="text-3xl font-bold text-center mb-8">{{ section.settings.main_title }}</h2>
        {% endif %}

        {% if section.settings.slides %}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {% for slide in section.settings.slides %}
                    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                        {% if slide.image %}
                            <img src="{{ slide.image }}" alt="{{ slide.title }}" class="w-full h-48 object-cover">
                        {% endif %}
                        {% if slide.title %}
                            <div class="p-4">
                                <h3 class="font-bold text-xl">{{ slide.title }}</h3>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
