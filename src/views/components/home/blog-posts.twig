{# =============================================================================
   سكشن: المدونة (Blog Posts)
   الوصف: عرض مقالات المدونة بتصميم شبكة جذاب مع صور وتفاصيل
   Created for: متجر mypetttt على منصة سله
   ============================================================================= #}

<section class="blog-posts-section py-12 md:py-16 bg-gray-50" dir="{{ direction }}">
    <div class="container mx-auto px-4">
        {# عنوان القسم #}
        <div class="section-title text-center mb-10">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">
                {{ section.settings.title | default('آخر المقالات') }}
            </h2>
            {% if section.settings.subtitle %}
                <p class="text-gray-600 max-w-2xl mx-auto">{{ section.settings.subtitle }}</p>
            {% endif %}
        </div>
        
        {# شبكة المقالات #}
        <div class="blog-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            
            {# مثال لمقالات ثابتة (للتجربة) - في الواقع ستجلب من system بمساعدة Twig #}
            {% set posts = [
                {
                    image: 'https://cdn.salla.sa/ZrBEO/MopzhoqpTkDObcKc8Q8n77AuydanfsGXdZO7iinH.jpg',
                    title: 'كيف تختار أفضل طعام لقطتك',
                    excerpt: 'تعرف على العناصر الغذائية الأساسية التي تحتاجها قطتك وكيف تختار الطعام المناسب لها.',
                    date: '2024-01-15',
                    author: 'د. أحمد علي',
                    comments: 5,
                    category: 'العناية بالقطط'
                },
                {
                    image: 'https://cdn.salla.sa/ZrBEO/3gOhYSaIhaHxhH2IHWxJYDl9JHwxP6dGKiZFSq4K.jpg',
                    title: 'نصائح لتدريب الجراء في المنزل',
                    excerpt: 'طرق فعالة ولطيفة لتدريب جروك الجديد على قضاء الحاجة في المكان المناسب.',
                    date: '2024-01-10',
                    author: 'م. خالد العمري',
                    comments: 8,
                    category: 'تدريب الكلاب'
                },
                {
                    image: 'https://cdn.salla.sa/ZrBEO/8kH2jHsL9pQrTsV5wNxYzA1bC3dE4fG5hI6jK7lM.jpg',
                    title: 'أهمية التطعيمات الدورية للحيوانات الأليفة',
                    excerpt: 'جدول التطعيمات الأساسية التي يجب أن تحصل عليها حيواناتك الأليفة لحمايتها من الأمراض.',
                    date: '2024-01-05',
                    author: 'د. سارة الفهد',
                    comments: 3,
                    category: 'صحة الحيوان'
                }
            ] %}
            
            {% for post in posts %}
                <div class="blog-card bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden group">
                    {# صورة المقال #}
                    <div class="blog-image relative h-56 overflow-hidden">
                        <img src="{{ post.image }}" 
                             alt="{{ post.title }}"
                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                        
                        {# تصنيف المقال #}
                        <div class="absolute top-4 right-4">
                            <span class="bg-blue-600 text-white text-xs font-bold px-3 py-1.5 rounded-full">
                                {{ post.category }}
                            </span>
                        </div>
                        
                        {# تاريخ المقال بشكل أيقونة #}
                        <div class="absolute bottom-4 left-4 bg-white/90 backdrop-blur-sm rounded-lg p-2 text-center">
                            <span class="block text-lg font-bold text-gray-900">{{ post.date | date('d') }}</span>
                            <span class="block text-xs text-gray-600">{{ post.date | date('M') }}</span>
                        </div>
                    </div>
                    
                    {# محتوى المقال #}
                    <div class="blog-content p-5">
                        <h3 class="text-xl font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-blue-600 transition-colors">
                            <a href="#" class="hover:underline">{{ post.title }}</a>
                        </h3>
                        
                        <p class="text-gray-600 mb-4 line-clamp-2">{{ post.excerpt }}</p>
                        
                        {# معلومات الكاتب والتعليقات #}
                        <div class="flex items-center justify-between text-sm text-gray-500 pt-4 border-t border-gray-100">
                            <div class="flex items-center">
                                <span class="w-6 h-6 bg-gray-200 rounded-full flex items-center justify-center ml-2">
                                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                    </svg>
                                </span>
                                {{ post.author }}
                            </div>
                            <div class="flex items-center">
                                <svg class="w-4 h-4 ml-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                                </svg>
                                {{ post.comments }}
                            </div>
                        </div>
                    </div>
                    
                    {# زر قراءة المزيد #}
                    <div class="blog-footer p-5 pt-0">
                        <a href="#" class="inline-flex items-center text-blue-600 font-medium hover:text-blue-700 transition">
                            <span>قراءة المزيد</span>
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
        
        {# زر عرض الكل #}
        {% if section.settings.show_view_all %}
            <div class="text-center mt-10">
                <a href="/blog" class="inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg transition-all transform hover:scale-105">
                    <span>عرض جميع المقالات</span>
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </a>
            </div>
        {% endif %}
    </div>
</section>

{% schema %}
{
    "name": {
        "ar": "المدونة",
        "en": "Blog Posts"
    },
    "icon": "sicon-document",
    "description": {
        "ar": "عرض مقالات المدونة بتصميم شبكة جذاب",
        "en": "Display blog posts in an attractive grid layout"
    },
    "settings": [
        {
            "type": "string",
            "id": "title",
            "label": {
                "ar": "عنوان القسم",
                "en": "Section Title"
            },
            "format": "text",
            "multilanguage": true,
            "value": {
                "ar": "آخر المقالات",
                "en": "Latest Posts"
            }
        },
        {
            "type": "string",
            "id": "subtitle",
            "label": {
                "ar": "نص فرعي",
                "en": "Subtitle"
            },
            "format": "textarea",
            "multilanguage": true,
            "required": false,
            "placeholder": {
                "ar": "أضف نصاً وصفياً للقسم...",
                "en": "Add a descriptive text..."
            }
        },
        {
            "type": "items",
            "id": "blog_posts",
            "label": {
                "ar": "مقالات محددة",
                "en": "Specific Posts"
            },
            "format": "dropdown-list",
            "description": {
                "ar": "اختر مقالات محددة للعرض (إذا تركت فارغة سيتم عرض أحدث المقالات)",
                "en": "Select specific posts (if empty, latest posts will be shown)"
            },
            "selected": [],
            "options": [],
            "required": false,
            "multichoice": true,
            "source": "blog_articles",
            "searchable": true,
            "maxLength": 6
        },
        {
            "type": "number",
            "id": "posts_count",
            "label": {
                "ar": "عدد المقالات",
                "en": "Number of Posts"
            },
            "format": "number",
            "value": 3,
            "minimum": 1,
            "maximum": 6,
            "description": {
                "ar": "عدد المقالات التي تريد عرضها (إذا لم تختر مقالات محددة)",
                "en": "Number of posts to display (if no specific posts selected)"
            }
        },
        {
            "type": "select",
            "id": "layout_style",
            "label": {
                "ar": "نمط العرض",
                "en": "Layout Style"
            },
            "format": "dropdown-list",
            "options": [
                {
                    "label": {
                        "ar": "شبكة 3 أعمدة",
                        "en": "3 Columns Grid"
                    },
                    "value": "grid-3"
                },
                {
                    "label": {
                        "ar": "شبكة 2 عمود",
                        "en": "2 Columns Grid"
                    },
                    "value": "grid-2"
                },
                {
                    "label": {
                        "ar": "سليدر",
                        "en": "Slider"
                    },
                    "value": "slider"
                }
            ],
            "selected": [
                {
                    "value": "grid-3"
                }
            ]
        },
        {
            "type": "boolean",
            "id": "show_view_all",
            "label": {
                "ar": "إظهار زر 'عرض جميع المقالات'",
                "en": "Show 'View All Posts' Button"
            },
            "format": "switch",
            "value": true
        },
        {
            "type": "boolean",
            "id": "show_author",
            "label": {
                "ar": "إظهار اسم الكاتب",
                "en": "Show Author"
            },
            "format": "switch",
            "value": true
        },
        {
            "type": "boolean",
            "id": "show_date",
            "label": {
                "ar": "إظهار التاريخ",
                "en": "Show Date"
            },
            "format": "switch",
            "value": true
        },
        {
            "type": "boolean",
            "id": "show_comments",
            "label": {
                "ar": "إظهار عدد التعليقات",
                "en": "Show Comments Count"
            },
            "format": "switch",
            "value": true
        },
        {
            "type": "boolean",
            "id": "show_category",
            "label": {
                "ar": "إظهار التصنيف",
                "en": "Show Category"
            },
            "format": "switch",
            "value": true
        }
    ]
}
{% endschema %}

<style>
/* تنسيق إضافي للنصوص الطويلة */
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* تأثيرات هوفر متطورة */
.blog-card {
    position: relative;
}

.blog-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: inherit;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
}

.blog-card:hover::before {
    opacity: 1;
}

/* تنسيق خاص للجوال */
@media (max-width: 768px) {
    .blog-card .blog-image {
        height: 200px;
    }
    
    .blog-content {
        padding: 1rem;
    }
    
    .blog-content h3 {
        font-size: 1.1rem;
    }
}
</style>

{% if section.settings.layout_style == 'slider' %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // هنا يمكن إضافة كود السليدر إذا تم اختيار نمط العرض كسليدر
    // هذا يتطلب مكتبة Swiper مثلاً
});
</script>
{% endif %}