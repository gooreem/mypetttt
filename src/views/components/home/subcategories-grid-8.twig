<style>
/* تنسيقات حسب نمط التخطيط */
{% if section.settings.layout_style == 'circular' %}
    .subcategory-card .pt-\[100\%\] {
        border-radius: 50%;
        overflow: hidden;
    }
    
    .subcategory-card .absolute.inset-0 {
        border-radius: 50%;
    }
    
    .subcategory-card:hover img {
        transform: scale(1.1) rotate(3deg);
    }
{% elseif section.settings.layout_style == 'gapped' %}
    .grid {
        gap: 1rem;
    }
    
    .subcategory-card {
        border-radius: 1rem;
        border: 1px solid rgba(0,0,0,0.05);
    }
{% endif %}

/* تأثيرات حركية متقدمة */
.subcategory-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.subcategory-card:hover {
    transform: translateY(-4px);
}

/* تأثير نبض خفيف للصورة */
@keyframes softPulse {
    0% { box-shadow: 0 0 0 0 rgba(33, 99, 109, 0.4); }
    70% { box-shadow: 0 0 0 6px rgba(33, 99, 109, 0); }
    100% { box-shadow: 0 0 0 0 rgba(33, 99, 109, 0); }
}

.subcategory-card:hover {
    animation: softPulse 2s infinite;
}

/* تنسيق النصوص الطويلة */
.line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* تجاوب للشاشات الصغيرة جداً */
@media (max-width: 480px) {
    .subcategory-card .p-3 {
        padding: 0.5rem;
    }
    
    .subcategory-card h3 {
        font-size: 0.75rem;
    }
    
    .subcategory-card p {
        font-size: 0.7rem;
    }
}

/* تأثير توهج للكروت */
@keyframes glow {
    0% { box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
    50% { box-shadow: 0 10px 15px -3px rgba(33, 99, 109, 0.2); }
    100% { box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
}

.subcategory-card:hover {
    animation: glow 2s infinite;
}
</style>