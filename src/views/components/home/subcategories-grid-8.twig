{# =============================================================================
   سكشن: أقسام فرعية - 8 مربعات (8 Subcategories Grid)
   الوصف: عرض 8 أقسام فرعية في شبكة من المربعات مع صور وتأثيرات حركية
   Created for: متجر mypetttt على منصة سله
   ============================================================================= #}

<section class="subcategories-grid-8-section py-16 md:py-20 bg-gray-50" dir="{{ direction }}">
    <div class="container mx-auto px-4">
        {# عنوان القسم #}
        <div class="section-title text-center mb-12">
            <span class="inline-block text-blue-600 font-semibold text-sm uppercase tracking-wider mb-2">
                {{ section.settings.badge_text | default('تصفح الأقسام') }}
            </span>
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
                {{ section.settings.title | default('الأقسام الفرعية') }}
            </h2>
            {% if section.settings.subtitle %}
                <p class="text-gray-600 max-w-2xl mx-auto text-lg">{{ section.settings.subtitle }}</p>
            {% endif %}
        </div>
        
        {# شبكة 8 أقسام - تصميم مرن #}
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-8 gap-3 md:gap-4">
            
            {% for subcategory in section.settings.subcategories %}
                <div class="subcategory-card group relative bg-white rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden">
                    
                    {# صورة القسم الفرعي #}
                    <div class="relative pt-[100%] overflow-hidden">
                        <img src="{{ subcategory.image | default('https://via.placeholder.com/200x200?text=Subcategory') }}" 
                             alt="{{ subcategory.name }}"
                             class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                        
                        {# خلفية متدرجة عند التمرير #}
                        <div class="absolute inset-0 bg-gradient-to-t from-blue-600/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                        
                        {# أيقونة أو علامة (اختياري) #}
                        {% if subcategory.icon %}
                            <div class="absolute top-2 right-2 w-8 h-8 bg-white/90 rounded-full flex items-center justify-center text-blue-600 transform group-hover:scale-110 transition">
                                <span class="{{ subcategory.icon }}"></span>
                            </div>
                        {% endif %}
                    </div>
                    
                    {# محتوى القسم #}
                    <div class="p-3 text-center">
                        <h3 class="font-bold text-gray-800 text-sm md:text-base mb-1 group-hover:text-blue-600 transition-colors line-clamp-1">
                            {{ subcategory.name }}
                        </h3>
                        
                        {% if subcategory.products_count %}
                            <p class="text-xs text-gray-500">
                                {{ subcategory.products_count }} منتج
                            </p>
                        {% endif %}
                    </div>
                    
                    {# رابط القسم (يجعل الكارت كله قابل للنقر) #}
                    <a href="{{ subcategory.link | default('#') }}" class="absolute inset-0 z-10" aria-label="{{ subcategory.name }}"></a>
                </div>
            {% endfor %}
        </div>
        
        {# عرض جميع الأقسام #}
        {% if section.settings.show_view_all %}
            <div class="text-center mt-10">
                <a href="{{ section.settings.view_all_link | default('/categories') }}" 
                   class="inline-flex items-center bg-white border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white font-bold py-3 px-8 rounded-lg transition-all transform hover:scale-105">
                    <span>عرض جميع الأقسام</span>
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </a>
            </div>
        {% endif %}
    </div>
</section>

