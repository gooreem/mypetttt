{# Horizontal Banner Section #}
<section class="py-12">
    <div class="container mx-auto px-4">
        {% if section.settings.banner_image %}
            <div class="relative rounded-lg overflow-hidden">
                <img src="{{ section.settings.banner_image }}" 
                     alt="{{ section.settings.banner_title }}" 
                     class="w-full h-96 object-cover">
                {% if section.settings.banner_title %}
                    <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center">
                        <h2 class="text-white text-4xl font-bold">{{ section.settings.banner_title }}</h2>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
</section>
