{# =============================================================================
   سكشن: بانر أفقي (Horizontal Banner)
   الوصف: بانر أفقي كامل العرض مع إمكانية إضافة نص ورابط
   Created for: متجر mypetttt على منصة سله
   ============================================================================= #}

<section class="horizontal-banner-section py-6 md:py-8" dir="{{ direction }}">
    <div class="container mx-auto px-4">
        {% if section.settings.banner_image %}
            <div class="relative rounded-2xl overflow-hidden group cursor-pointer"
                 onclick="window.location='{{ section.settings.banner_link | default('javascript:void(0)') }}'">
                
                {# صورة البانر - تتغير حسب حجم الشاشة #}
                <picture>
                    {# للجوال: صورة مختلفة إذا وجدت #}
                    {% if section.settings.mobile_image %}
                        <source media="(max-width: 768px)" srcset="{{ section.settings.mobile_image }}">
                    {% endif %}
                    {# للكمبيوتر: الصورة الأساسية #}
                    <img src="{{ section.settings.banner_image }}" 
                         alt="{{ section.settings.banner_text | default('Banner') }}"
                         class="w-full h-auto md:h-[400px] object-cover transition-transform duration-700 group-hover:scale-105">
                </picture>
                
                {# طبقة تعتم خفيفة لإبراز النص #}
                <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-transparent to-transparent"></div>
                
                {# محتوى البانر (نص) - يظهر إذا كان موجوداً #}
                {% if section.settings.banner_text %}
                    <div class="absolute inset-0 flex items-center">
                        <div class="text-white text-right p-6 md:p-10 max-w-xl">
                            <h2 class="text-2xl md:text-4xl lg:text-5xl font-bold leading-tight drop-shadow-lg">
                                {{ section.settings.banner_text }}
                            </h2>
                            
                            {% if section.settings.button_text %}
                                <div class="mt-4 md:mt-6">
                                    <span class="inline-block bg-white text-gray-900 font-bold py-3 px-8 rounded-lg hover:bg-opacity-90 transition-all transform hover:scale-105">
                                        {{ section.settings.button_text }}
                                    </span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
                
                {# شارة "تسوق الآن" إذا لم يكن هناك نص مخصص #}
                {% if not section.settings.banner_text and section.settings.banner_link %}
                    <div class="absolute inset-0 flex items-center justify-center">
                        <span class="bg-white text-gray-900 font-bold py-3 px-8 rounded-lg opacity-90 hover:opacity-100 transition">
                            {{ section.settings.button_text | default('تسوق الآن') }}
                        </span>
                    </div>
                {% endif %}
            </div>
        {% else %}
            {# رسالة إذا لم توجد صورة - تظهر فقط للمطور #}
            {% if is_developer_mode %}
                <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 p-4 rounded-lg text-center">
                    يرجى إضافة صورة للبانر من إعدادات القسم
                </div>
            {% endif %}
        {% endif %}
    </div>
</section>

{% schema %}
{
    "name": {
        "ar": "بانر أفقي",
        "en": "Horizontal Banner"
    },
    "icon": "sicon-image",
    "description": {
        "ar": "بانر أفقي كامل العرض مع إمكانية إضافة نص ورابط",
        "en": "Full width horizontal banner with text and link"
    },
    "settings": [
        {
            "type": "string",
            "id": "banner_image",
            "label": {
                "ar": "صورة البانر (للكمبيوتر)",
                "en": "Banner Image (Desktop)"
            },
            "format": "image",
            "required": true,
            "description": {
                "ar": "* المقاس المناسب: 1920×400 بكسل",
                "en": "* Recommended size: 1920×400 px"
            }
        },
        {
            "type": "string",
            "id": "mobile_image",
            "label": {
                "ar": "صورة البانر للجوال (اختياري)",
                "en": "Mobile Banner Image (Optional)"
            },
            "format": "image",
            "required": false,
            "description": {
                "ar": "إذا لم تضع صورة منفصلة، سيتم تصغير صورة الكمبيوتر تلقائياً",
                "en": "If not provided, desktop image will be scaled down"
            }
        },
        {
            "type": "string",
            "id": "banner_text",
            "label": {
                "ar": "نص على البانر",
                "en": "Banner Text"
            },
            "format": "textarea",
            "multilanguage": true,
            "required": false,
            "placeholder": {
                "ar": "أدخل النص الذي سيظهر على البانر...",
                "en": "Enter text to display on banner..."
            }
        },
        {
            "type": "string",
            "id": "button_text",
            "label": {
                "ar": "نص الزر",
                "en": "Button Text"
            },
            "format": "text",
            "multilanguage": true,
            "required": false,
            "placeholder": {
                "ar": "تسوق الآن",
                "en": "Shop Now"
            }
        },
        {
            "type": "items",
            "id": "banner_link",
            "label": {
                "ar": "رابط البانر",
                "en": "Banner Link"
            },
            "format": "variable-list",
            "required": false,
            "searchable": true,
            "source": "custom",
            "sources": [
                {
                    "label": {
                        "ar": "منتج",
                        "en": "Product"
                    },
                    "key": "products",
                    "value": "products"
                },
                {
                    "label": {
                        "ar": "تصنيف",
                        "en": "Category"
                    },
                    "key": "categories",
                    "value": "categories"
                },
                {
                    "label": {
                        "ar": "ماركة تجارية",
                        "en": "Brand"
                    },
                    "key": "brands",
                    "value": "brands"
                },
                {
                    "label": {
                        "ar": "صفحة تعريفية",
                        "en": "Page"
                    },
                    "key": "pages",
                    "value": "pages"
                },
                {
                    "label": {
                        "ar": "التخفيضات",
                        "en": "Offers"
                    },
                    "key": "offers_link",
                    "value": "offers_link"
                },
                {
                    "label": {
                        "ar": "رابط خارجي",
                        "en": "Custom URL"
                    },
                    "key": "custom",
                    "value": "custom"
                }
            ]
        },
        {
            "type": "select",
            "id": "text_position",
            "label": {
                "ar": "مكان النص",
                "en": "Text Position"
            },
            "format": "dropdown-list",
            "options": [
                {
                    "label": {
                        "ar": "يسار",
                        "en": "Left"
                    },
                    "value": "left"
                },
                {
                    "label": {
                        "ar": "يمين",
                        "en": "Right"
                    },
                    "value": "right"
                },
                {
                    "label": {
                        "ar": "وسط",
                        "en": "Center"
                    },
                    "value": "center"
                }
            ],
            "selected": [
                {
                    "value": "left"
                }
            ],
            "description": {
                "ar": "مكان ظهور النص على البانر",
                "en": "Where to display the text on the banner"
            }
        }
    ]
}
{% endschema %}

<style>
/* تنسيقات إضافية حسب مكان النص */
{% if section.settings.text_position == 'left' %}
    .horizontal-banner-section .absolute.inset-0 {
        justify-content: flex-start;
    }
{% elseif section.settings.text_position == 'right' %}
    .horizontal-banner-section .absolute.inset-0 {
        justify-content: flex-end;
    }
    .horizontal-banner-section .absolute.inset-0 > div {
        text-align: left;
    }
{% elseif section.settings.text_position == 'center' %}
    .horizontal-banner-section .absolute.inset-0 {
        justify-content: center;
    }
    .horizontal-banner-section .absolute.inset-0 > div {
        text-align: center;
    }
{% endif %}
</style>